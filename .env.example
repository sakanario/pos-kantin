# Lokal: file SQLite. Produksi: URL Turso (libsql://xxx.turso.io)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# String acak panjang untuk tanda tangan cookie sesi
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Pembayaran pesan online (/pesan): "midtrans" (QRIS + GoPay, butuh kunci di bawah) atau "palsu" = tombol
# "Simulasikan bayar" untuk mencoba di laptop (ditolak di Vercel). Kosong = pesan online mati (katalog lihat saja).
GATEWAY=
# Midtrans: dashboard → Settings → Access Keys. Sandbox kecuali MIDTRANS_PRODUCTION=true.
# Notification URL di dashboard: https://<domain>/api/gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=
# Web push notifikasi pesanan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak untuk layanan push (mailto: atau https:)
VAPID_SUBJECT=
